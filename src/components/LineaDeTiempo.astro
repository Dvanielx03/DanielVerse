---
// La línea de tiempo: un marcador por escena, el cabezal y el código de tiempo.
import { INTERFAZ } from '../datos/interfaz';
import { ESCENAS, type Escena, type Idioma } from '../datos/pelicula';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = INTERFAZ[idioma];
const pantallasDe = (escena: Escena) => escena.planos.reduce((suma, plano) => suma + plano.pantallas, 0);
---

<nav class="linea" aria-label={textos.lineaDeTiempo}>
  <div class="linea__pista">
    <ol class="linea__escenas">
      {
        ESCENAS.map((escena, numero) => {
          const primero = escena.planos[0]?.id;
          return (
            <li style={`flex-grow:${pantallasDe(escena)}`}>
              <a href={`#${primero}`} data-ir={primero} data-escena-marcador={escena.id}>
                <span class="mono" aria-hidden="true">{numero}</span>
                <span class="linea__nombre">{escena.nombre[idioma]}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
    <span class="linea__cabezal" aria-hidden="true"></span>
  </div>
  <p class="linea__codigo mono">
    <span class="solo-lectores">{textos.codigoDeTiempo}: </span>
    <span data-codigo>00:00:00</span>
  </p>
</nav>

<style>
  .linea {
    position: fixed;
    inset: auto 0 0;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 8px max(12px, env(safe-area-inset-right, 0px)) calc(8px + env(safe-area-inset-bottom, 0px))
      max(12px, env(safe-area-inset-left, 0px));
    border-top: 1.5px solid var(--texto);
    background: var(--fondo);
    color: var(--texto);
    transition:
      opacity var(--f4) linear,
      transform var(--f4) var(--asentar);
  }

  /* Nace con la ruptura. Antes solo aparece si recibe el foco del teclado. */
  :global([data-linea='oculta']) .linea:not(:focus-within) {
    opacity: 0;
    transform: translateY(100%);
    pointer-events: none;
  }

  .linea__pista {
    position: relative;
    min-width: 0;
  }

  .linea__escenas {
    display: flex;
    gap: 3px;
  }

  .linea__escenas li {
    flex-basis: 0;
    min-width: 0;
  }

  .linea__escenas a {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 8px;
    overflow: hidden;
    border: 1.5px solid var(--linea);
    color: var(--texto);
    font-size: 0.75rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .linea__escenas a[aria-current] {
    border-color: var(--grafito);
    background: var(--amarillo);
    color: var(--grafito);
    font-weight: 800;
  }

  .linea__nombre {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .linea__cabezal {
    position: absolute;
    top: -5px;
    bottom: -5px;
    left: calc(var(--t, 0) * 100%);
    width: 2px;
    background: var(--nota);
  }

  .linea__codigo {
    font-size: 0.8125rem;
  }

  @media (pointer: coarse) {
    .linea__escenas a {
      height: 44px;
    }
  }

  @media (max-width: 720px) {
    .linea__escenas a {
      justify-content: center;
      padding: 0;
    }

    /* El nombre sigue disponible para lectores de pantalla. */
    .linea__nombre {
      position: absolute;
      width: 1px;
      height: 1px;
      clip-path: inset(50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .linea {
      transition: none;
    }
  }
</style>
