---
// La barra de escenas: un marcador por escena y un cabezal que dice por dónde vas.
import { INTERFAZ } from '../datos/interfaz';
import { ESCENAS, type Escena, type Idioma } from '../datos/pelicula';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = INTERFAZ[idioma];
const pantallasDe = (escena: Escena) => escena.planos.reduce((suma, plano) => suma + plano.pantallas, 0);
---

<nav class="linea" aria-label={textos.lineaDeTiempo}>
  <div class="linea__pista">
    <ol class="linea__escenas">
      {
        ESCENAS.map((escena, numero) => {
          const primero = escena.planos[0]?.id;
          return (
            <li style={`flex-grow:${pantallasDe(escena)}`}>
              <a href={`#${primero}`} data-ir={primero} data-escena-marcador={escena.id}>
                <span class="mono" aria-hidden="true">
                  {numero}
                </span>
                <span class="linea__nombre">{escena.nombre[idioma]}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
    <span class="linea__cabezal" aria-hidden="true"></span>
  </div>
</nav>

<style>
  .linea {
    position: fixed;
    inset: auto 0 0;
    z-index: 3;
    padding: 8px max(12px, env(safe-area-inset-right, 0px)) calc(8px + env(safe-area-inset-bottom, 0px))
      max(12px, env(safe-area-inset-left, 0px));
    border-top: 2.5px solid #05030c;
    background: color-mix(in srgb, #05030c 86%, transparent);
    color: var(--pantalla);
    backdrop-filter: blur(6px);
    transition:
      opacity var(--f4) linear,
      transform var(--f4) var(--asentar);
  }

  /* Nace con la ruptura. Antes solo aparece si recibe el foco del teclado. */
  :global([data-linea='oculta']) .linea:not(:focus-within) {
    opacity: 0;
    transform: translateY(100%);
    pointer-events: none;
  }

  .linea__pista {
    position: relative;
    min-width: 0;
  }

  .linea__escenas {
    display: flex;
    gap: 4px;
  }

  .linea__escenas li {
    flex-basis: 0;
    min-width: 0;
  }

  .linea__escenas a {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 8px;
    overflow: hidden;
    border: 1.5px solid rgb(246 239 228 / 0.22);
    color: var(--pantalla);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition:
      translate var(--f2) var(--golpe),
      border-color var(--f2) linear;
  }

  .linea__escenas a .mono {
    color: var(--cian);
  }

  .linea__escenas a:hover {
    border-color: var(--cian);
    translate: 0 -3px;
  }

  /* La escena en la que estás: un cartucho amarillo con su sombra de tinta. */
  .linea__escenas a[aria-current] {
    border-color: #05030c;
    background: var(--amarillo);
    color: #05030c;
    font-weight: 800;
    box-shadow: 3px 3px 0 var(--magenta);
  }

  .linea__escenas a[aria-current] .mono {
    color: #05030c;
  }

  .linea__nombre {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* El cabezal: una línea magenta con su eco cian, que se separa cuando vas rápido. */
  .linea__cabezal {
    position: absolute;
    top: -6px;
    bottom: -6px;
    left: calc(var(--t, 0) * 100%);
    width: 3px;
    background: var(--magenta);
    box-shadow: calc(var(--v, 0) * -14px - 3px) 0 0 var(--cian);
  }

  @media (pointer: coarse) {
    .linea__escenas a {
      height: 44px;
    }
  }

  @media (max-width: 720px) {
    .linea__escenas a {
      justify-content: center;
      padding: 0;
    }

    /* El nombre sigue disponible para lectores de pantalla. */
    .linea__nombre {
      position: absolute;
      width: 1px;
      height: 1px;
      clip-path: inset(50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .linea,
    .linea__escenas a {
      transition: none;
    }
  }
</style>
