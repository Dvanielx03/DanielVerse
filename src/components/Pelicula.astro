---
// La página entera: los planos en orden, la hoja de contacto y la línea de tiempo.
import '@fontsource-variable/recursive/full.css';
import '@fontsource-variable/shantell-sans';
import '../estilos/tokens.css';
import '../estilos/base.css';

import { getRelativeLocaleUrl } from 'astro:i18n';

import { INTERFAZ } from '../datos/interfaz';
import { ESCENAS, type Idioma } from '../datos/pelicula';
import { construirIndice } from '../motor/tiempo';
import HojaDeContacto from './HojaDeContacto.astro';
import LineaDeTiempo from './LineaDeTiempo.astro';
import Plano from './Plano.astro';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = INTERFAZ[idioma];
const otroIdioma: Idioma = idioma === 'es' ? 'en' : 'es';
const indice = construirIndice(ESCENAS);
---

<!doctype html>
<html lang={idioma} data-mundo="papel">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={textos.descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{textos.titulo}</title>
  </head>
  <body>
    <a class="salto" href="#hoja">{textos.saltarAHoja}</a>
    <header class="controles">
      <h1 class="solo-lectores">{textos.titulo}</h1>
      <button type="button" data-sonido aria-pressed="false">
        <span class="altavoz" aria-hidden="true"><i></i><i></i><i></i></span>
        {textos.sonido}
      </button>
      <a data-idioma href={getRelativeLocaleUrl(otroIdioma, '')} lang={otroIdioma} hreflang={otroIdioma}>
        {textos.cambiarIdioma}
      </a>
      <a href="#hoja">{textos.hoja}</a>
    </header>
    <main>
      {indice.entradas.map((entrada) => <Plano entrada={entrada} idioma={idioma} />)}
    </main>
    <HojaDeContacto idioma={idioma} />
    <LineaDeTiempo idioma={idioma} />
    <script>
      import '../motor/pelicula.ts';
    </script>
  </body>
</html>

<style>
  .salto {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 5;
    padding: 10px 14px;
    background: var(--amarillo);
    color: var(--grafito);
    font-weight: 800;
    transform: translateY(-200%);
  }

  .salto:focus {
    transform: none;
  }

  .controles {
    position: fixed;
    top: max(10px, env(safe-area-inset-top, 0px));
    right: max(12px, env(safe-area-inset-right, 0px));
    z-index: 4;
    display: flex;
    gap: 8px;
  }

  .controles :is(a, button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 4px 12px;
    border: 1.5px solid var(--texto);
    background: var(--fondo);
    color: var(--texto);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .controles :is(a, button):hover {
    background: var(--texto);
    color: var(--fondo);
  }

  /* El sonido necesita el motor: sin JavaScript el botón no aparece. */
  .controles button {
    display: none;
  }

  :global(.con-motor) .controles button {
    display: inline-flex;
  }

  .controles button[aria-pressed='true'] {
    border-color: var(--amarillo);
    background: var(--amarillo);
    color: var(--grafito);
  }

  /* Tres barras de vúmetro: quietas y bajas con el sonido apagado; a saltos cuando suena. */
  .altavoz {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .altavoz i {
    width: 3px;
    height: 3px;
    background: currentColor;
  }

  button[aria-pressed='true'] .altavoz i {
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    button[aria-pressed='true'] .altavoz i {
      animation: vumetro 0.667s steps(4, end) infinite;
    }

    button[aria-pressed='true'] .altavoz i:nth-child(2) {
      animation-delay: -0.25s;
    }

    button[aria-pressed='true'] .altavoz i:nth-child(3) {
      animation-delay: -0.45s;
    }
  }

  @keyframes vumetro {
    50% {
      height: 30%;
    }
  }

  @media (pointer: coarse) {
    .controles :is(a, button) {
      min-height: 44px;
    }
  }

</style>
