---
// La página entera: los planos en orden, la hoja de contacto y la línea de tiempo.
import '@fontsource-variable/recursive/full.css';
import '@fontsource-variable/shantell-sans';
import '../estilos/tokens.css';
import '../estilos/base.css';

import { getRelativeLocaleUrl } from 'astro:i18n';

import { INTERFAZ } from '../datos/interfaz';
import { ESCENAS, type Idioma } from '../datos/pelicula';
import { construirIndice } from '../motor/tiempo';
import HojaDeContacto from './HojaDeContacto.astro';
import LineaDeTiempo from './LineaDeTiempo.astro';
import Plano from './Plano.astro';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = INTERFAZ[idioma];
const otroIdioma: Idioma = idioma === 'es' ? 'en' : 'es';
const indice = construirIndice(ESCENAS);
---

<!doctype html>
<html lang={idioma} data-mundo="papel">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={textos.descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{textos.titulo}</title>
  </head>
  <body>
    <a class="salto" href="#hoja">{textos.saltarAHoja}</a>
    <header class="controles">
      <h1 class="solo-lectores">{textos.titulo}</h1>
      <button type="button" data-sonido aria-pressed="false">
        <span class="altavoz" aria-hidden="true"><i></i><i></i><i></i></span>
        {textos.sonido}
      </button>
      <a data-idioma href={getRelativeLocaleUrl(otroIdioma, '')} lang={otroIdioma} hreflang={otroIdioma}>
        {textos.cambiarIdioma}
      </a>
      <a href="#hoja">{textos.hoja}</a>
    </header>
    <div class="ambiente" aria-hidden="true">
      <span class="ambiente__foco"></span>
      <span class="ambiente__lineas"></span>
    </div>
    <main>
      {indice.entradas.map((entrada) => <Plano entrada={entrada} idioma={idioma} />)}
    </main>
    <HojaDeContacto idioma={idioma} />
    <LineaDeTiempo idioma={idioma} />
    <script>
      import '../motor/pelicula.ts';
    </script>
  </body>
</html>

<style>
  .salto {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 5;
    padding: 10px 14px;
    background: var(--amarillo);
    color: var(--grafito);
    font-weight: 800;
    transform: translateY(-200%);
  }

  .salto:focus {
    transform: none;
  }

  .controles {
    position: fixed;
    top: max(10px, env(safe-area-inset-top, 0px));
    right: max(12px, env(safe-area-inset-right, 0px));
    z-index: 4;
    display: flex;
    gap: 8px;
  }

  .controles :is(a, button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 4px 12px;
    border: 1.5px solid var(--texto);
    background: var(--fondo);
    color: var(--texto);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .controles :is(a, button):hover {
    background: var(--texto);
    color: var(--fondo);
  }

  /* El sonido necesita el motor: sin JavaScript el botón no aparece. */
  .controles button {
    display: none;
  }

  :global(.con-motor) .controles button {
    display: inline-flex;
  }

  .controles button[aria-pressed='true'] {
    border-color: var(--amarillo);
    background: var(--amarillo);
    color: var(--grafito);
  }

  /* Tres barras de vúmetro: quietas y bajas con el sonido apagado; a saltos cuando suena. */
  .altavoz {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .altavoz i {
    width: 3px;
    height: 3px;
    background: currentColor;
  }

  button[aria-pressed='true'] .altavoz i {
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    button[aria-pressed='true'] .altavoz i {
      animation: vumetro 0.667s steps(4, end) infinite;
    }

    button[aria-pressed='true'] .altavoz i:nth-child(2) {
      animation-delay: -0.25s;
    }

    button[aria-pressed='true'] .altavoz i:nth-child(3) {
      animation-delay: -0.45s;
    }
  }

  @keyframes vumetro {
    50% {
      height: 30%;
    }
  }

  @media (pointer: coarse) {
    .controles :is(a, button) {
      min-height: 44px;
    }
  }

  /* El ambiente vive por encima de las secciones y no estorba: no recibe clics. */
  .ambiente {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor) .ambiente {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: block;
      overflow: hidden;
      pointer-events: none;
    }
  }

  /* La linterna: alrededor del cursor aparece la trama de puntos, como si la luz revelara la tinta. */
  .ambiente__foco {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, var(--magenta) 24%, transparent 26%) 0 0 / 12px 12px;
    mask-image: radial-gradient(
      circle 16vmax at calc(var(--mx, 0.5) * 100%) calc(var(--my, 0.4) * 100%),
      #000 0%,
      transparent 100%
    );
    mix-blend-mode: screen;
    opacity: 0.32;
  }

  :global([data-mundo='papel']) .ambiente__foco {
    background-image: radial-gradient(circle, var(--tinta-azul) 24%, transparent 26%);
    mix-blend-mode: multiply;
    opacity: 0.22;
  }

  /* Líneas de velocidad en los bordes: solo se ven mientras deslizas, y más cuanto más rápido. */
  .ambiente__lineas {
    position: absolute;
    inset: -20% 0;
    background:
      repeating-linear-gradient(90deg, transparent 0 37px, var(--pantalla) 37px 39px, transparent 39px 113px),
      repeating-linear-gradient(90deg, transparent 0 71px, var(--cian) 71px 72px, transparent 72px 157px);
    mask-image: linear-gradient(90deg, #000 0%, transparent 16%, transparent 84%, #000 100%);
    opacity: calc(var(--va, 0) * 0.5);
    translate: 0 calc(var(--v, 0) * -8%);
  }

  :global([data-mundo='papel']) .ambiente__lineas {
    filter: invert(1);
  }

  @media (pointer: coarse) {
    .ambiente__foco {
      display: none;
    }
  }
</style>
