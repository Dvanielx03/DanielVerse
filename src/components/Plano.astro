---
// Un plano de la película. Si tiene puesta en escena propia la usa; si no, composición tipográfica.
import type { Idioma } from '../datos/pelicula';
import { codigoDeTiempo, type Entrada } from '../motor/tiempo';
import Avatar from './arte/Avatar.astro';
import Claqueta from './arte/Claqueta.astro';
import Contacto from './arte/Contacto.astro';
import Convencional from './arte/Convencional.astro';
import Creditos from './arte/Creditos.astro';
import Diptico from './arte/Diptico.astro';
import Herramientas from './arte/Herramientas.astro';
import Inspeccion from './arte/Inspeccion.astro';
import Pared from './arte/Pared.astro';
import Pixel from './arte/Pixel.astro';
import Proyecto from './arte/Proyecto.astro';
import Reto from './arte/Reto.astro';
import Ruptura from './arte/Ruptura.astro';
import Truco from './arte/Truco.astro';

interface Props {
  entrada: Entrada;
  idioma: Idioma;
}

const { entrada, idioma } = Astro.props;
const { plano, escena, inicio } = entrada;
const idTitulo = `titulo-${plano.id}`;
const arte = plano.arte;

// La puesta en escena de cada tipo de plano.
const piezas = {
  claqueta: Claqueta,
  convencional: Convencional,
  ruptura: Ruptura,
  'avatar-boceto': Avatar,
  'avatar-tinta': Avatar,
  'avatar-final': Avatar,
  reto: Reto,
  pared: Pared,
  proyecto: Proyecto,
  diptico: Diptico,
  inspeccion: Inspeccion,
  truco: Truco,
  herramientas: Herramientas,
  pixel: Pixel,
  creditos: Creditos,
  contacto: Contacto,
};
const Pieza = arte ? piezas[arte] : undefined;
---

<section
  class="plano"
  id={plano.id}
  data-plano={plano.id}
  data-mundo={plano.mundo}
  data-fundido={plano.fundido ? '' : undefined}
  style={`--pantallas:${plano.pantallas}`}
  aria-labelledby={idTitulo}
>
  <div class="plano__escenario">
    <p class="plano__claqueta mono">
      <span class="plano__barras" aria-hidden="true"></span>
      <span>{escena.nombre[idioma]}</span>
      <span>{plano.id}</span>
      <span>{codigoDeTiempo(inicio)}</span>
    </p>

    {Pieza && <Pieza plano={plano} idioma={idioma} idTitulo={idTitulo} />}

    {
      !arte && (
        <div class="plano__contenido">
          {plano.titular ? (
            <h2 id={idTitulo} class="plano__titular">
              {plano.titular[idioma]}
            </h2>
          ) : (
            <h2 id={idTitulo} class="plano__etiqueta mono">
              {plano.nombre[idioma]}
            </h2>
          )}
          {plano.lineas && (
            <ul class:list={['plano__lineas', { 'plano__lineas--solas': !plano.titular }]}>
              {plano.lineas[idioma].map((linea) => (
                <li>{linea}</li>
              ))}
            </ul>
          )}
          {plano.sello && <p class="plano__sello">{plano.sello[idioma]}</p>}
          {plano.nota && <p class="adhesiva a-mano">{plano.nota[idioma]}</p>}
          {plano.enlaces && (
            <ul class="plano__enlaces">
              {plano.enlaces.map((enlace) => (
                <li>
                  <a href={enlace.url}>{enlace.etiqueta[idioma]}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .plano {
    position: relative;
  }

  .plano__escenario {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 14px;
    padding: 14px max(16px, 4vw) 72px;
    overflow: hidden;
    color: var(--texto);
  }

  /* Mundo de papel: mesa de luz, clara en el centro, con grano. */
  .plano[data-mundo='papel'] .plano__escenario {
    background:
      var(--grano-papel),
      radial-gradient(ellipse 85% 95% at 50% 58%, #fbfcfb 0%, var(--papel) 52%, #cdd5d0 100%);
  }

  /* Mundo de sala: un solo haz desde arriba a la izquierda. */
  .plano[data-mundo='sala'] .plano__escenario {
    background:
      var(--grano-sala),
      conic-gradient(
        from 98deg at 0% 6%,
        transparent 0deg,
        rgb(243 235 221 / 0.13) 7deg,
        rgb(243 235 221 / 0.03) 19deg,
        transparent 27deg
      ),
      radial-gradient(ellipse 70% 80% at 68% 45%, #1a2038 0%, var(--sala) 62%, #080b14 100%);
  }

  /* Con el motor en marcha, cada sección es duración de scroll y su escenario queda fijo. */
  :global(.con-motor) .plano {
    height: calc(var(--pantallas) * 100svh);
  }

  :global(.con-motor) .plano__escenario {
    position: fixed;
    inset: 0;
    min-height: 0;
    opacity: 0;
    pointer-events: none;
  }

  :global(.con-motor) .plano.es-activo .plano__escenario {
    opacity: 1;
    pointer-events: auto;
  }

  :global(.con-motor) .plano[data-fundido] .plano__escenario {
    transition: opacity var(--f4) steps(4, end);
  }

  /* Movimiento reducido: los planos vuelven al flujo normal, uno debajo de otro. */
  @media (prefers-reduced-motion: reduce) {
    :global(.con-motor) .plano {
      height: auto;
    }

    :global(.con-motor) .plano__escenario,
    :global(.con-motor) .plano[data-fundido] .plano__escenario {
      position: relative;
      inset: auto;
      min-height: 100svh;
      opacity: 1;
      pointer-events: auto;
      transition: none;
    }
  }

  /* Claqueta del plano */
  .plano__claqueta {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    justify-self: start;
    padding-right: 12px;
    border: 1.5px solid var(--linea);
    background: var(--fondo);
    color: var(--texto-2);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .plano__barras {
    align-self: stretch;
    width: 44px;
    min-height: 24px;
    border-right: 1.5px solid var(--linea);
    background: repeating-linear-gradient(-58deg, var(--texto) 0 6px, transparent 6px 12px);
  }

  /* En pantallas estrechas la claqueta baja para no quedar bajo los controles. */
  @media (max-width: 640px) {
    .plano__escenario {
      padding-top: 64px;
    }
  }

  /* Composición tipográfica */
  .plano__contenido {
    align-self: center;
    display: grid;
    justify-items: start;
    gap: clamp(14px, 2.4vw, 24px);
    max-width: 64rem;
    min-width: 0;
  }

  .plano__titular {
    font-size: clamp(2.5rem, 8.4vw, 6.5rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  /* Fuera de registro: un titular por pantalla y solo en sala. */
  .plano[data-mundo='sala'] .plano__titular {
    text-shadow:
      -0.035em 0 var(--rojo-luz),
      0.035em 0 var(--azul-luz);
  }

  .plano__etiqueta {
    font-size: 0.75rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--amarillo);
  }

  .plano__lineas {
    display: grid;
    gap: 6px;
    max-width: 50ch;
    padding-left: 16px;
    border-left: 3px solid var(--amarillo);
    font-size: clamp(1.05rem, 2.1vw, 1.5rem);
    color: var(--texto-2);
  }

  .plano__lineas--solas {
    max-width: 32ch;
    font-size: clamp(1.4rem, 3.6vw, 2.5rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--texto);
    text-wrap: balance;
  }

  .plano__sello {
    padding: 5px 16px 4px;
    border: 3px double var(--nota);
    border-radius: 4px;
    color: var(--nota);
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    transform: rotate(-5deg);
  }

  .plano__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .plano__enlaces a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 18px;
    border: 1.5px solid var(--texto);
    background: var(--texto);
    color: var(--fondo);
    font-weight: 800;
    text-decoration: none;
  }

  .plano__enlaces a:hover {
    background: var(--amarillo);
    border-color: var(--amarillo);
    color: var(--grafito);
  }

  /* Cada elemento se asienta al entrar el plano; el sello cae con golpe. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor) .plano.es-activo .plano__contenido > * {
      animation: asentar var(--f8) var(--asentar) both;
    }

    :global(.con-motor) .plano.es-activo .plano__contenido > :nth-child(2) {
      animation-delay: var(--f1);
    }

    :global(.con-motor) .plano.es-activo .plano__contenido > :nth-child(3) {
      animation-delay: var(--f2);
    }

    :global(.con-motor) .plano.es-activo .plano__contenido > :nth-child(n + 4) {
      animation-delay: var(--f4);
    }

    :global(.con-motor) .plano.es-activo .plano__contenido > .plano__sello {
      animation: sellar var(--f4) var(--golpe) var(--f4) both;
    }
  }

  @keyframes asentar {
    from {
      opacity: 0;
      translate: 0 22px;
    }
  }

  @keyframes sellar {
    from {
      opacity: 0;
      scale: 1.8;
    }
  }
</style>
