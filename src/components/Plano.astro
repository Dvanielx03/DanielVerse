---
// Una sección de la experiencia: su puesta en escena, su aire y su manera de entrar.
import { ESCENAS, type Idioma } from '../datos/pelicula';
import { TONO_POR_ESCENA, TRANSICION_POR_ARTE } from '../datos/transiciones';
import type { Entrada } from '../motor/tiempo';
import Avatar from './arte/Avatar.astro';
import Claqueta from './arte/Claqueta.astro';
import Contacto from './arte/Contacto.astro';
import Convencional from './arte/Convencional.astro';
import Creditos from './arte/Creditos.astro';
import Diptico from './arte/Diptico.astro';
import Herramientas from './arte/Herramientas.astro';
import Inspeccion from './arte/Inspeccion.astro';
import Pared from './arte/Pared.astro';
import Pixel from './arte/Pixel.astro';
import Reel from './arte/Reel.astro';
import Proyecto from './arte/Proyecto.astro';
import Reto from './arte/Reto.astro';
import Ruptura from './arte/Ruptura.astro';
import Truco from './arte/Truco.astro';

interface Props {
  entrada: Entrada;
  idioma: Idioma;
}

const { entrada, idioma } = Astro.props;
const { plano, escena, indice } = entrada;
const idTitulo = `titulo-${plano.id}`;
const arte = plano.arte;

// La puesta en escena de cada tipo de plano.
const piezas = {
  claqueta: Claqueta,
  convencional: Convencional,
  ruptura: Ruptura,
  'avatar-boceto': Avatar,
  'avatar-tinta': Avatar,
  'avatar-final': Avatar,
  reto: Reto,
  pared: Pared,
  proyecto: Proyecto,
  diptico: Diptico,
  inspeccion: Inspeccion,
  truco: Truco,
  herramientas: Herramientas,
  pixel: Pixel,
  creditos: Creditos,
  contacto: Contacto,
  reel: Reel,
};
const Pieza = arte ? piezas[arte] : undefined;

// La primera sección no tiene de dónde venir: aparece sin más.
const transicion = indice === 0 || !arte ? 'corte' : TRANSICION_POR_ARTE[arte];
// Las secciones alternan de lado para que no entren todas por el mismo sitio.
const lado = indice % 2 === 0 ? 1 : -1;
const tono = TONO_POR_ESCENA[escena.id] ?? '#7b3dff';
const numero = String(ESCENAS.indexOf(escena)).padStart(2, '0');
---

<section
  class="plano"
  id={plano.id}
  data-plano={plano.id}
  data-mundo={plano.mundo}
  data-transicion={transicion}
  data-lado={lado}
  data-ciudad={arte === 'avatar-final' || arte === 'contacto' ? 'izquierda' : undefined}
  style={`--pantallas:${plano.pantallas};--lado:${lado};--tono:${tono}`}
  aria-labelledby={idTitulo}
>
  <div class="plano__marco">
    <div class="plano__escenario">
      {plano.mundo === 'sala' && <span class="plano__ciudad" aria-hidden="true" />}
      <span class="plano__trama" aria-hidden="true"></span>

      <p class="plano__rotulo">
        <span class="mono">{numero}</span>
        {escena.nombre[idioma]}
      </p>

      {Pieza && <Pieza plano={plano} idioma={idioma} idTitulo={idTitulo} />}

      {
        !Pieza && (
          <div class="plano__contenido">
            <h2 id={idTitulo} class="plano__titular">
              {plano.titular?.[idioma] ?? plano.nombre[idioma]}
            </h2>
            {plano.lineas && (
              <ul class="plano__lineas">
                {plano.lineas[idioma].map((linea) => (
                  <li>{linea}</li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .plano {
    position: relative;
  }

  .plano__escenario {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 14px;
    padding: 14px max(16px, 4vw) 72px;
    overflow: hidden;
    color: var(--texto);
  }

  /* Mundo de papel: mesa de luz, clara en el centro, con grano. */
  .plano[data-mundo='papel'] .plano__escenario {
    background:
      var(--grano-papel),
      radial-gradient(ellipse 85% 95% at 50% 58%, #fbfcfb 0%, var(--papel) 52%, #cdd5d0 100%);
  }

  /* Mundo de sala: la noche de la ciudad, teñida con el color de la escena. */
  .plano[data-mundo='sala'] .plano__escenario {
    background:
      var(--grano-sala),
      radial-gradient(
        ellipse 62% 72% at calc(50% + var(--lado) * 24%) 38%,
        color-mix(in oklab, var(--tono) 30%, transparent) 0%,
        transparent 72%
      ),
      linear-gradient(180deg, #090716 0%, #110b29 52%, #1d0f3c 100%);
  }

  /* La trama: dos campos de puntos de semitono, uno por tinta, que asoman desde las esquinas. */
  .plano__trama,
  .plano__trama::after {
    position: absolute;
    inset: -8%;
    z-index: -1;
    pointer-events: none;
  }

  .plano__trama {
    background: radial-gradient(circle, var(--tono) 30%, transparent 32%) 0 0 / 15px 15px;
    mask-image: radial-gradient(ellipse 52% 58% at calc(50% - var(--lado) * 46%) 96%, #000 0%, transparent 72%);
    opacity: 0.55;
    translate: 0 calc(var(--v, 0) * -36px);
  }

  .plano__trama::after {
    content: '';
    inset: 0;
    background: radial-gradient(circle, var(--magenta) 26%, transparent 28%) 0 0 / 24px 24px;
    mask-image: radial-gradient(ellipse 40% 46% at calc(50% + var(--lado) * 48%) 2%, #000 0%, transparent 70%);
    opacity: 0.5;
  }

  .plano[data-mundo='papel'] .plano__trama {
    background-image: radial-gradient(circle, var(--cian) 28%, transparent 30%);
    opacity: 0.4;
  }

  /* La ciudad al fondo, que se desliza despacio mientras avanzas. */
  .plano__ciudad {
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: min(38%, 300px);
    background: var(--ciudad) calc(var(--t, 0) * -1100px + var(--lado) * 180px) 100% / auto 100% repeat-x;
    mask-image: linear-gradient(to top, #000 55%, transparent);
    opacity: 0.9;
    pointer-events: none;
  }

  /* Donde hay un personaje a la derecha, la ciudad se queda a la izquierda para no asomar a través de él. */
  .plano[data-ciudad='izquierda'] .plano__ciudad {
    right: 40%;
    mask-image: linear-gradient(to top, #000 55%, transparent), linear-gradient(to right, #000 62%, transparent);
    mask-composite: intersect;
  }

  /* El rótulo de la escena, como un cartucho de cómic. */
  .plano__rotulo {
    position: relative;
    z-index: 3;
    justify-self: start;
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 4px 12px 3px;
    border: 2.5px solid #05030c;
    background: var(--amarillo);
    color: #05030c;
    font-size: 0.8125rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    box-shadow: 4px 4px 0 #05030c;
    rotate: -1.6deg;
  }

  .plano__rotulo .mono {
    font-weight: 400;
  }

  /* En pantallas estrechas el rótulo baja para no quedar bajo los controles. */
  @media (max-width: 640px) {
    .plano__escenario {
      padding-top: 64px;
    }
  }

  /* Composición de reserva, para un plano sin puesta en escena propia. */
  .plano__contenido {
    align-self: center;
    display: grid;
    justify-items: start;
    gap: clamp(14px, 2.4vw, 24px);
    max-width: 64rem;
    min-width: 0;
  }

  .plano__titular {
    font-size: clamp(2.5rem, 8.4vw, 6.5rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .plano__lineas {
    display: grid;
    gap: 6px;
    max-width: 50ch;
    padding-left: 16px;
    border-left: 3px solid var(--amarillo);
    font-size: clamp(1.05rem, 2.1vw, 1.5rem);
    color: var(--texto-2);
  }

  /* ——— Con el motor en marcha: cada sección es duración de scroll y su escenario queda fijo ———
     Con movimiento reducido nada de esto se aplica y las secciones se leen una debajo de otra. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor) .plano {
      --entra: 1;
      --sale: 0;
      height: calc(var(--pantallas) * 100svh);
    }

    :global(.con-motor) .plano__marco {
      position: fixed;
      inset: 0;
      opacity: 0;
      pointer-events: none;
    }

    :global(.con-motor) .plano__escenario {
      /* El avance de la entrada, suavizado al principio y al final. */
      --e: calc(var(--entra) * var(--entra) * (3 - 2 * var(--entra)));
      position: absolute;
      inset: 0;
      min-height: 0;
    }

    :global(.con-motor) .plano:is(.es-activo, .es-saliente) .plano__marco {
      opacity: 1;
    }

    :global(.con-motor) .plano.es-activo .plano__marco {
      pointer-events: auto;
    }

    /* La sección que se va se hunde un poco: se apaga y se aleja. */
    :global(.con-motor) .plano.es-saliente .plano__escenario {
      scale: calc(1 - 0.05 * var(--sale));
      filter: brightness(calc(1 - 0.45 * var(--sale))) saturate(calc(1 - 0.4 * var(--sale)));
    }

    /* El borde de lo que entra lleva las dos tintas fuera de registro. */
    @media (min-width: 761px) {
      :global(.con-motor) .plano.en-transicion .plano__marco {
        filter: drop-shadow(calc(var(--lado) * -0.8vw) 0 0 var(--magenta))
          drop-shadow(calc(var(--lado) * -0.8vw) 0 0 var(--cian));
      }
    }

    /* Tajo: un corte en diagonal que barre la pantalla desde un lado. */
    :global(.con-motor) .plano[data-transicion='tajo'].en-transicion .plano__escenario {
      --x: calc((1 - var(--e)) * 136%);
      clip-path: polygon(var(--x) 0, 100% 0, 100% 100%, calc(var(--x) - 36%) 100%);
    }

    :global(.con-motor) .plano[data-transicion='tajo'][data-lado='-1'].en-transicion .plano__escenario {
      clip-path: polygon(0 0, calc(100% - var(--x)) 0, calc(136% - var(--x)) 100%, 0 100%);
    }

    /* Semitono: los puntos de imprenta crecen hasta juntarse. */
    :global(.con-motor) .plano[data-transicion='semitono'].en-transicion .plano__escenario {
      mask-image: radial-gradient(
        circle at center,
        #000 calc(var(--e) * 102%),
        transparent calc(var(--e) * 102% + 1.5px)
      );
      mask-size: 4.6vmax 4.6vmax;
      mask-position: center;
    }

    /* Glitch: franjas que se desplazan y engordan, como una señal que se recompone. */
    :global(.con-motor) .plano[data-transicion='glitch'].en-transicion .plano__escenario {
      mask-image: repeating-linear-gradient(
        180deg,
        #000 0 calc(var(--e) * 12.6svh),
        transparent calc(var(--e) * 12.6svh) 12.5svh
      );
      translate: calc((1 - var(--e)) * var(--lado) * 6vw) 0;
    }

    /* Viñeta: entra de lado, con su calle negra, y empuja a la anterior. */
    :global(.con-motor) .plano[data-transicion='vineta'].en-transicion .plano__escenario {
      translate: calc((1 - var(--e)) * var(--lado) * 102vw) 0;
      box-shadow: calc(var(--lado) * -2.4vw) 0 0 #05030c;
    }

    :global(.con-motor) .plano.es-saliente[data-sale='vineta'] .plano__escenario {
      translate: calc(var(--sale) * var(--hacia, 1) * -30vw) 0;
    }

    /* Estallido: una estrella de cómic que se abre desde el centro. */
    :global(.con-motor) .plano[data-transicion='estallido'].en-transicion .plano__escenario {
      --r: calc(var(--e) * 100vmax);
      clip-path: polygon(
        calc(50% + var(--r) * 0.000) calc(50% + var(--r) * -1.000),
        calc(50% + var(--r) * 0.198) calc(50% + var(--r) * -0.545),
        calc(50% + var(--r) * 0.643) calc(50% + var(--r) * -0.766),
        calc(50% + var(--r) * 0.502) calc(50% + var(--r) * -0.290),
        calc(50% + var(--r) * 0.985) calc(50% + var(--r) * -0.174),
        calc(50% + var(--r) * 0.571) calc(50% + var(--r) * 0.101),
        calc(50% + var(--r) * 0.866) calc(50% + var(--r) * 0.500),
        calc(50% + var(--r) * 0.373) calc(50% + var(--r) * 0.444),
        calc(50% + var(--r) * 0.342) calc(50% + var(--r) * 0.940),
        calc(50% + var(--r) * 0.000) calc(50% + var(--r) * 0.580),
        calc(50% + var(--r) * -0.342) calc(50% + var(--r) * 0.940),
        calc(50% + var(--r) * -0.373) calc(50% + var(--r) * 0.444),
        calc(50% + var(--r) * -0.866) calc(50% + var(--r) * 0.500),
        calc(50% + var(--r) * -0.571) calc(50% + var(--r) * 0.101),
        calc(50% + var(--r) * -0.985) calc(50% + var(--r) * -0.174),
        calc(50% + var(--r) * -0.502) calc(50% + var(--r) * -0.290),
        calc(50% + var(--r) * -0.643) calc(50% + var(--r) * -0.766),
        calc(50% + var(--r) * -0.198) calc(50% + var(--r) * -0.545)
      );
    }

    /* Iris: un círculo que se abre. */
    :global(.con-motor) .plano[data-transicion='iris'].en-transicion .plano__escenario {
      clip-path: circle(calc(var(--e) * 60vmax) at 50% 50%);
    }

    /* Zoom: la cámara atraviesa la sección anterior y aterriza en esta. */
    :global(.con-motor) .plano[data-transicion='zoom'].en-transicion .plano__escenario {
      opacity: var(--e);
      scale: calc(1.3 - 0.3 * var(--e));
    }

    :global(.con-motor) .plano.es-saliente[data-sale='zoom'] .plano__escenario {
      scale: calc(1 + 0.7 * var(--sale));
      opacity: calc(1 - var(--sale));
      filter: none;
    }
  }
</style>
