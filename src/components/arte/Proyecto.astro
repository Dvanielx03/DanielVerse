---
// E4 · Claqueta de un proyecto: nombre, año, stack y sello de estado, en su color de acento.
import type { Idioma, Plano } from '../../datos/pelicula';

interface Props {
  plano: Plano;
  idioma: Idioma;
  idTitulo: string;
}

const { plano, idioma, idTitulo } = Astro.props;
---

<div class="proy" style={`--acento:${plano.acento}`}>
  <div class="proy__claq" aria-hidden="true">
    <span class="proy__palo"></span>
    <span class="proy__base"></span>
  </div>
  <div class="proy__tabla">
    <h2 id={idTitulo} class="proy__nombre">{plano.titular?.[idioma]}</h2>
    <ul class="proy__datos mono">
      {plano.lineas?.[idioma].map((linea) => <li>{linea}</li>)}
    </ul>
    {
      plano.enlaces?.map((enlace) => (
        <a class="proy__repo" href={enlace.url}>
          <span class="mono">GitHub</span>
          {enlace.etiqueta[idioma]}
          <span aria-hidden="true">↗</span>
        </a>
      ))
    }
    {plano.sello && <p class="proy__sello">{plano.sello[idioma]}</p>}
  </div>
</div>

<style>
  .proy {
    --cierre: 1;
    align-self: center;
    justify-self: center;
    width: min(880px, 100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor) .proy {
      --cierre: round(down, clamp(0, calc((var(--p, 0) - 0.08) / 0.3), 1), 0.2);
    }
  }

  .proy__claq {
    display: grid;
    gap: 4px;
  }

  .proy__palo,
  .proy__base {
    display: block;
    height: clamp(22px, 4vw, 40px);
    background: repeating-linear-gradient(-58deg, var(--acento) 0 22px, var(--sala) 22px 44px);
    box-shadow: inset 0 0 0 3px var(--acento);
  }

  .proy__palo {
    transform-origin: 0 100%;
    transform: rotate(calc(-11deg * (1 - var(--cierre))));
  }

  .proy__base {
    background: repeating-linear-gradient(58deg, var(--acento) 0 22px, var(--sala) 22px 44px);
  }

  .proy__tabla {
    position: relative;
    display: grid;
    gap: clamp(10px, 2vw, 20px);
    padding: clamp(18px, 4vw, 44px);
    border: 3px solid var(--acento);
    border-top: 0;
    background: rgb(9 7 22 / 0.86);
  }

  .proy__nombre {
    font-size: clamp(3rem, 12vw, 9rem);
    font-weight: 900;
    line-height: 0.86;
    letter-spacing: -0.03em;
    color: var(--acento);
  }

  .proy__datos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    font-size: clamp(0.85rem, 1.7vw, 1.15rem);
    color: var(--pantalla);
  }

  /* El acceso directo al código, como un cartucho de cómic. */
  .proy__repo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 8px 18px;
    border: 2.5px solid #05030c;
    background: var(--acento);
    color: #05030c;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 5px 5px 0 #05030c;
    transition:
      translate var(--f2) var(--golpe),
      box-shadow var(--f2) var(--golpe);
  }

  .proy__repo .mono {
    padding: 1px 6px;
    background: #05030c;
    color: var(--acento);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .proy__repo:hover {
    translate: -2px -2px;
    box-shadow: 8px 8px 0 var(--magenta);
  }

  .proy__sello {
    position: absolute;
    right: clamp(12px, 3vw, 36px);
    bottom: clamp(12px, 3vw, 32px);
    padding: 5px 16px 4px;
    border: 3px double var(--pantalla);
    border-radius: 4px;
    font-size: clamp(0.9rem, 1.8vw, 1.25rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    rotate: -6deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor .plano.es-activo) .proy__sello {
      animation: sellar-proyecto var(--f4) var(--golpe) var(--f8) both;
    }
  }

  @keyframes sellar-proyecto {
    from {
      opacity: 0;
      scale: 1.9;
    }
  }

  @media (max-width: 640px) {
    .proy__sello {
      position: static;
      justify-self: start;
    }
  }
</style>
