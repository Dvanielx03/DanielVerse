---
// E5-P3 · Y Si Pixel: un cuadro pequeño de estética píxel junto al enlace al canal.
import type { Idioma, Plano } from '../../datos/pelicula';

interface Props {
  plano: Plano;
  idioma: Idioma;
  idTitulo: string;
}

const { plano, idioma, idTitulo } = Astro.props;

// Cada dibujo es una rejilla de caracteres; cada carácter, un color de la paleta.
const paleta: Record<string, string> = {
  p: '#3a2418', // pelo
  c: '#f0c9a0', // cara
  o: '#1b1440', // ojos
  r: '#ff5a47', // camiseta
  a: '#6ea2ff', // pantalón
  b: '#f3ebdd', // perro
  m: '#b9793f', // mancha del perro
  y: '#ffc93c', // interrogación
};
const nino = ['..pppp..', '.pppppp.', '.pccccp.', '.coccoc.', '.cccccc.', '..rrrr..', '.rrrrrr.', 'crrrrrrc', '..rrrr..', '..a..a..', '..a..a..'];
const perro = ['......b.b', 'b.....bbb', 'bbmmbbbob', '.bbmbbbbb', '.b.b..b.b', '.b.b..b.b'];
const pregunta = ['.yyy.', 'y...y', '....y', '...y.', '..y..', '.....', '..y..'];
const pintar = (filas: string[], x0: number, y0: number) =>
  filas.flatMap((fila, y) =>
    [...fila].flatMap((c, x) => (paleta[c] ? [{ x: x0 + x, y: y0 + y, color: paleta[c] }] : [])),
  );
const suelo = 21;
const figuras = [...pintar(nino, 9, suelo - nino.length), ...pintar(perro, 20, suelo - perro.length)];
const signo = pintar(pregunta, 31, 4);
const estrellas = [
  [4, 3],
  [14, 2],
  [24, 6],
  [40, 4],
  [44, 11],
  [3, 11],
  [27, 12],
  [37, 14],
];
---

<div class="pix">
  <svg class="pix__cuadro flota" viewBox="0 0 48 27" shape-rendering="crispEdges" aria-hidden="true">
    <rect width="48" height="27" fill="#1b1440"></rect>
    <rect x="36" y="2" width="5" height="5" fill="#f3ebdd" opacity="0.12"></rect>
    {estrellas.map(([x, y], i) => <rect class={`estrella estrella--${i % 2}`} x={x} y={y} width="1" height="1" fill="#f3ebdd" />)}
    <rect x="0" y={suelo} width="48" height="6" fill="#2b2f6b"></rect>
    <rect x="0" y={suelo} width="48" height="1" fill="#6ea2ff"></rect>
    {figuras.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.color} />)}
    <g class="pix__signo">
      {signo.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.color} />)}
    </g>
  </svg>

  <div class="pix__texto">
    <h2 id={idTitulo} class="pix__titular mono">{plano.titular?.[idioma]}</h2>
    <p class="pix__linea">{plano.lineas?.[idioma][0]}</p>
    {
      plano.enlaces?.map((enlace) => (
        <a class="pix__enlace" href={enlace.url}>
          {enlace.etiqueta[idioma]}
        </a>
      ))
    }
  </div>
</div>

<style>
  .pix {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(16px, 4vw, 56px);
    min-height: 0;
  }

  .pix__cuadro {
    width: 100%;
    max-height: 60svh;
    border: 4px solid var(--pantalla);
    image-rendering: pixelated;
    rotate: -2deg;
  }

  /* Dos fotogramas por segundo, como un sprite: la pregunta flota y las estrellas parpadean. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor .es-activo) .pix__signo {
      animation: flotar 1s steps(1, end) infinite;
    }

    :global(.con-motor .es-activo) .estrella--1 {
      animation: parpadear 1.5s steps(1, end) infinite;
    }
  }

  @keyframes flotar {
    50% {
      translate: 0 -1px;
    }
  }

  @keyframes parpadear {
    50% {
      opacity: 0.25;
    }
  }

  .pix__texto {
    display: grid;
    justify-items: start;
    gap: clamp(12px, 2vw, 20px);
  }

  .pix__titular {
    font-size: clamp(2.2rem, 6.6vw, 5rem);
    font-weight: 900;
    line-height: 0.95;
    color: var(--amarillo);
  }

  .pix__linea {
    max-width: 24ch;
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    color: var(--texto-2);
  }

  .pix__enlace {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 18px;
    background: var(--amarillo);
    color: var(--grafito);
    font-weight: 800;
    text-decoration: none;
  }

  .pix__enlace:hover {
    background: var(--pantalla);
  }

  @media (max-width: 760px) {
    .pix {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
    }

    .pix__cuadro {
      max-height: 30svh;
    }
  }
</style>
