---
// E6-P2 · Contacto. El cierre: el avatar dibujado da paso a la toma real, punto a punto, como una
// trama de imprenta que se llena; al final, un iris se cierra sobre la foto sin tapar los enlaces.
import { Picture } from 'astro:assets';

import final from '../../assets/avatar/final.png';
import foto from '../../assets/foto/daniel.jpg';
import { INTERFAZ } from '../../datos/interfaz';
import type { Idioma, Plano } from '../../datos/pelicula';

interface Props {
  plano: Plano;
  idioma: Idioma;
  idTitulo: string;
}

const { plano, idioma, idTitulo } = Astro.props;
const textos = INTERFAZ[idioma];
---

<div class="cont">
  <div class="cont__texto">
    <h2 id={idTitulo} class="cont__titular">{plano.titular?.[idioma]}</h2>
    <ul class="cont__enlaces">
      {
        plano.enlaces?.map((enlace) => (
          <li>
            <a href={enlace.url}>{enlace.etiqueta[idioma]}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- El dibujo: se funde con la noche y se apaga cuando llega la foto. -->
  <figure class="cont__dibujo flota" aria-hidden="true">
    <Picture
      src={final}
      formats={['avif', 'webp']}
      widths={[640, 960, 1344, 1672]}
      sizes="(max-width: 820px) 180vw, 110vw"
      alt={textos.altAvatar.final}
      loading="lazy"
    />
  </figure>

  <!-- La toma real, en su viñeta. -->
  <figure class="cont__foto flota">
    <Picture
      src={foto}
      formats={['avif', 'webp']}
      widths={[400, 600, 800]}
      sizes="(max-width: 820px) 60vw, 34vw"
      alt={textos.altFoto}
      loading="lazy"
    />
    <figcaption class="cont__etiqueta a-mano">{textos.tomaReal}</figcaption>
  </figure>

  <span class="cont__iris" aria-hidden="true"></span>
</div>

<style>
  /* Sin motor o con movimiento reducido: la foto ya a la vista, sin dibujo ni iris. */
  .cont {
    --iris: 0;
    --real: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(16px, 4vw, 64px);
    min-height: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor) .cont {
      --real: clamp(0, calc((var(--p, 0) - 0.14) / 0.3), 1);
      --iris: clamp(0, calc((var(--p, 0) - 0.62) / 0.38), 1);
    }
  }

  .cont__texto {
    position: relative;
    z-index: 2;
    grid-row: 1;
    grid-column: 1;
    display: grid;
    justify-items: start;
    gap: clamp(16px, 3vw, 32px);
    min-width: 0;
  }

  .cont__titular {
    max-width: 12ch;
    font-size: clamp(2.4rem, 7.6vw, 6rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.015em;
    text-wrap: balance;
    text-shadow:
      calc(var(--registro) * -1) 0 var(--rojo-luz),
      var(--registro) 0 var(--azul-luz);
  }

  .cont__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .cont__enlaces a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 10px 22px;
    border: 2.5px solid #05030c;
    background: var(--amarillo);
    color: #05030c;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 800;
    text-decoration: none;
    box-shadow: 4px 4px 0 #05030c;
    transition:
      translate var(--f2) var(--golpe),
      box-shadow var(--f2) var(--golpe);
  }

  .cont__enlaces a:hover {
    translate: -2px -2px;
    box-shadow: 7px 7px 0 var(--magenta);
  }

  /* Dibujo y foto ocupan la misma celda: uno encima del otro. */
  .cont__dibujo,
  .cont__foto {
    grid-row: 1;
    grid-column: 2;
    justify-self: center;
    height: min(72svh, 620px);
    aspect-ratio: 4 / 5;
    margin: 0;
  }

  .cont__dibujo {
    mix-blend-mode: lighten;
    scale: 1.08;
    opacity: calc(1 - var(--real));
  }

  .cont__dibujo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 91% 50%;
    mask-image: linear-gradient(to right, transparent 0%, #000 22%);
  }

  /* La viñeta de la foto: borde de tinta, sombra en dos tintas y una trama que se llena con el scroll. */
  .cont__foto {
    position: relative;
    z-index: 1;
    height: min(66svh, 560px);
    border: 4px solid #05030c;
    background: #05030c;
    box-shadow:
      12px 12px 0 var(--magenta),
      20px 20px 0 var(--cian);
    rotate: 1.8deg;
    mask-image: radial-gradient(circle at center, #000 calc(var(--real) * 102%), transparent calc(var(--real) * 102% + 1px));
    mask-size: 30px 30px;
    mask-position: center;
  }

  .cont__foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* La etiqueta de la toma, pegada como una nota. */
  .cont__etiqueta {
    position: absolute;
    left: -16px;
    bottom: 22px;
    padding: 6px 14px 5px;
    border: 2.5px solid #05030c;
    background: var(--amarillo);
    color: #05030c;
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    box-shadow: 4px 4px 0 #05030c;
    rotate: -6deg;
  }

  /* Iris: un círculo de luz que se cierra hacia la foto sin tapar los enlaces. */
  .cont__iris {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      circle at 74% 46%,
      transparent calc(140vmax - var(--iris) * 108vmax),
      rgb(4 6 12 / 0.9) calc(140vmax - var(--iris) * 108vmax + 2px)
    );
  }

  @media (max-width: 820px) {
    .cont {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      justify-items: center;
    }

    .cont__dibujo,
    .cont__foto {
      grid-row: 1;
      grid-column: 1;
      height: min(40svh, 340px);
    }

    .cont__foto {
      height: min(36svh, 300px);
      box-shadow:
        7px 7px 0 var(--magenta),
        12px 12px 0 var(--cian);
    }

    .cont__texto {
      grid-row: 2;
      justify-self: stretch;
    }

    .cont__iris {
      display: none;
    }
  }
</style>
