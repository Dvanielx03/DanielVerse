---
// E3 · Retos. Montaje rápido: cada plano entra y sale con un barrido ligado al scroll,
// y su esquema se dibuja trazo a trazo mientras el plano avanza.
import type { Idioma, Plano } from '../../datos/pelicula';

interface Props {
  plano: Plano;
  idioma: Idioma;
  idTitulo: string;
}

const { plano, idioma, idTitulo } = Astro.props;
const dibujo = plano.dibujo;
// Las salas del campus: tres filas de cuatro.
const salas = [0, 1, 2].flatMap((fila) => [0, 1, 2, 3].map((col) => ({ n: fila * 4 + col, x: 36 + col * 84, y: 40 + fila * 70 })));
---

<div class="reto">
  <p class="reto__fecha" aria-hidden="true">{plano.fecha}</p>

  <div class="reto__texto">
    <h2 id={idTitulo} class="reto__titular">{plano.titular?.[idioma]}</h2>
    <ul class="reto__lineas">
      {plano.lineas?.[idioma].map((linea) => <li>{linea}</li>)}
    </ul>
    {plano.sello && <p class="reto__sello">{plano.sello[idioma]}</p>}
    {
      plano.enlaces?.map((enlace) => (
        <a class="reto__enlace" href={enlace.url}>
          {enlace.etiqueta[idioma]}
        </a>
      ))
    }
  </div>

  <svg class="reto__dibujo flota" viewBox="0 0 400 300" aria-hidden="true">
    {
      dibujo === 'robot' && (
        <g>
          <path class="tenue" d="M16 270 H384" />
          <rect pathLength="1" x="60" y="212" width="280" height="48" rx="24" />
          <circle pathLength="1" cx="96" cy="236" r="13" />
          <circle pathLength="1" cx="152" cy="236" r="13" />
          <circle pathLength="1" cx="208" cy="236" r="13" />
          <circle pathLength="1" cx="264" cy="236" r="13" />
          <circle pathLength="1" cx="312" cy="236" r="13" />
          <rect pathLength="1" x="112" y="140" width="176" height="72" rx="8" />
          <path pathLength="1" d="M132 170 H196 M132 188 H172" />
          <circle pathLength="1" cx="250" cy="176" r="13" />
          <line pathLength="1" x1="170" y1="140" x2="170" y2="98" />
          <rect pathLength="1" class="acento" x="142" y="62" width="56" height="36" rx="8" />
          <circle pathLength="1" cx="170" cy="80" r="8" />
          <path pathLength="1" d="M288 164 L334 124 L358 146" />
          <path pathLength="1" d="M358 146 L372 132 M358 146 L374 156" />
          <path pathLength="1" class="acento" d="M228 140 V96" />
          <path class="lleno" d="M228 96 L266 108 L228 120 Z" />
          <path pathLength="1" class="acento" d="M122 62 q-12 18 0 36 M106 50 q-22 30 0 60" />
        </g>
      )
    }
    {
      dibujo === 'campus' && (
        <g>
          {salas.map((sala) =>
            sala.n % 5 === 1 ? (
              <rect class="lleno" x={sala.x} y={sala.y} width="72" height="56" rx="6" />
            ) : sala.n % 7 === 3 ? (
              <rect class="alerta" x={sala.x} y={sala.y} width="72" height="56" rx="6" />
            ) : (
              <rect pathLength="1" x={sala.x} y={sala.y} width="72" height="56" rx="6" />
            ),
          )}
          <rect pathLength="1" x="36" y="262" width="328" height="16" rx="8" />
          <rect class="reloj" x="40" y="266" width="320" height="8" rx="4" />
        </g>
      )
    }
    {
      dibujo === 'vision' && (
        <g>
          <rect pathLength="1" x="36" y="36" width="328" height="228" rx="8" />
          <path pathLength="1" d="M36 210 L120 150 L176 190 L250 120 L364 204" />
          <circle pathLength="1" cx="300" cy="84" r="18" />
          <path pathLength="1" d="M52 68 V52 H68 M332 52 H348 V68 M348 232 V248 H332 M68 248 H52 V232" />
          <rect class="caja" x="92" y="118" width="96" height="92" />
          <rect class="caja" x="222" y="92" width="86" height="118" />
          <rect class="etiqueta" x="92" y="100" width="52" height="18" />
          <rect class="etiqueta" x="222" y="74" width="52" height="18" />
          <path class="escaner" d="M40 150 H360" />
        </g>
      )
    }
    {
      dibujo === 'acceso' && (
        <g>
          <path pathLength="1" d="M170 20 L200 56 L230 20" />
          <rect pathLength="1" x="124" y="56" width="152" height="212" rx="14" />
          <rect pathLength="1" x="182" y="68" width="36" height="10" rx="5" />
          <circle pathLength="1" cx="200" cy="124" r="28" />
          <line pathLength="1" x1="152" y1="176" x2="248" y2="176" />
          <line pathLength="1" x1="164" y1="196" x2="236" y2="196" />
          <path
            pathLength="1"
            d="M150 224 V250 M158 224 V250 M170 224 V250 M176 224 V250 M188 224 V250 M198 224 V250 M204 224 V250 M216 224 V250"
          />
          <circle class="lleno" cx="282" cy="236" r="40" />
          <path pathLength="1" class="visto" d="M262 236 L277 252 L304 220" />
        </g>
      )
    }
  </svg>
</div>

<style>
  /* Sin motor: el plano quieto en su sitio, con el esquema ya dibujado. */
  .reto {
    --traza: 1;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(16px, 4vw, 56px);
    min-height: 0;
  }

  /* Barrido: entra desde la derecha y sale por la izquierda, a saltos de animación dibujada.
     Entre medias, el esquema se traza. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor) .reto {
      --traza: clamp(0, calc((var(--p, 0) - 0.24) / 0.36), 1);
    }
  }

  /* La fecha, enorme y en contorno, asoma por abajo y se desliza más despacio que el resto. */
  .reto__fecha {
    position: absolute;
    left: -1vw;
    bottom: -34px;
    z-index: -1;
    font-size: clamp(5.5rem, 17vw, 15rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 2px rgb(243 235 221 / 0.16);
    translate: calc((0.5 - var(--p, 0.5)) * 8vw) 0;
  }

  .reto__texto {
    display: grid;
    justify-items: start;
    gap: clamp(12px, 2vw, 22px);
    min-width: 0;
  }

  .reto__titular {
    font-size: clamp(2.3rem, 7vw, 5.5rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.015em;
    text-wrap: balance;
    text-shadow:
      calc(var(--registro) * -1) 0 var(--rojo-luz),
      var(--registro) 0 var(--azul-luz);
  }

  .reto__lineas {
    display: grid;
    gap: 6px;
    max-width: 46ch;
    padding-left: 16px;
    border-left: 3px solid var(--amarillo);
    font-size: clamp(1rem, 2vw, 1.4rem);
    color: var(--texto-2);
  }

  .reto__sello {
    padding: 5px 16px 4px;
    border: 3px double var(--rojo-luz);
    border-radius: 4px;
    color: var(--rojo-luz);
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    rotate: -5deg;
  }

  .reto__enlace {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 18px;
    background: var(--pantalla);
    color: var(--sala);
    font-weight: 800;
    text-decoration: none;
  }

  .reto__enlace:hover {
    background: var(--amarillo);
  }

  /* Esquemas en línea clara, con el amarillo para lo que importa. */
  .reto__dibujo {
    width: 100%;
    max-height: 64svh;
    fill: none;
    stroke: var(--pantalla);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Cada trazo continuo se dibuja de principio a fin. */
  .reto__dibujo :global([pathLength]) {
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--traza));
    opacity: clamp(0, calc(var(--traza) * 50), 1);
  }

  .reto__dibujo :global(.acento) {
    stroke: var(--amarillo);
  }

  /* Lo que va relleno o a rayas no se traza: aparece cuando el dibujo ya está casi hecho. */
  .reto__dibujo :global(.lleno) {
    fill: var(--amarillo);
    stroke: var(--amarillo);
    opacity: clamp(0, calc((var(--traza) - 0.7) * 10), 1);
  }

  .reto__dibujo :global(.alerta) {
    stroke: var(--rojo-luz);
    stroke-dasharray: 6 6;
    opacity: clamp(0, calc((var(--traza) - 0.85) * 10), 1);
  }

  .reto__dibujo :global(.caja) {
    stroke: var(--amarillo);
    stroke-dasharray: 8 6;
    opacity: clamp(0, calc((var(--traza) - 0.6) * 10), 1);
  }

  .reto__dibujo :global(.etiqueta) {
    fill: var(--amarillo);
    stroke: none;
    opacity: clamp(0, calc((var(--traza) - 0.75) * 10), 1);
  }

  .reto__dibujo :global(.tenue) {
    stroke: rgb(243 235 221 / 0.4);
    stroke-dasharray: 2 10;
  }

  /* El visto es el último trazo. */
  .reto__dibujo :global(.visto) {
    stroke: var(--sala);
    stroke-width: 7;
    stroke-dashoffset: calc(1 - clamp(0, calc((var(--traza) - 0.85) * 6.67), 1));
  }

  /* El reloj del campus: la barra se llena con el avance del plano. */
  .reto__dibujo :global(.reloj) {
    fill: var(--rojo-luz);
    stroke: none;
    transform-origin: 40px 270px;
    transform: scaleX(clamp(0.04, var(--p, 0.7), 1));
  }

  /* La línea de escáner recorre la imagen de arriba abajo. */
  .reto__dibujo :global(.escaner) {
    stroke: var(--rojo-luz);
    stroke-width: 2;
    transform: translateY(calc((var(--p, 0.5) - 0.5) * 190px));
  }

  @media (max-width: 760px) {
    .reto {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
    }

    .reto__dibujo {
      order: -1;
      max-height: 26svh;
    }

    .reto__fecha {
      bottom: -24px;
    }
  }
</style>
