---
// E2 · Quién. El avatar en una de sus tres pasadas, con la frase de Daniel al lado.
// Las tres pasadas usan el mismo encuadre para que casen al cambiar de plano.
import { Picture } from 'astro:assets';

import boceto from '../../assets/avatar/boceto.png';
import final from '../../assets/avatar/final.png';
import tinta from '../../assets/avatar/tinta.png';
import { INTERFAZ } from '../../datos/interfaz';
import type { Idioma, Plano } from '../../datos/pelicula';

interface Props {
  plano: Plano;
  idioma: Idioma;
  idTitulo: string;
}

const { plano, idioma, idTitulo } = Astro.props;
const textos = INTERFAZ[idioma];
const pasadas = { 'avatar-boceto': 'boceto', 'avatar-tinta': 'tinta', 'avatar-final': 'final' } as const;
const pasada = pasadas[plano.arte as keyof typeof pasadas] ?? 'boceto';
const fuente = { boceto, tinta, final }[pasada];
const numero = { boceto: 1, tinta: 2, final: 3 }[pasada];
const frase = plano.lineas?.[idioma]?.[0];

// En la pasada final el visitante puede volver a mirar las anteriores: es el selector de capas.
const capas = ['boceto', 'tinta', 'final'] as const;
const fuentes = { boceto, tinta, final };
const nombres = { boceto: textos.capaBoceto, tinta: textos.capaTinta, final: textos.capaFinal };
const conSelector = pasada === 'final';
const grupo = `pasada-${plano.id}`;
const visibles = conSelector ? capas : [pasada];
---

<div class="quien" data-pasada={pasada} style={`--n:${numero - 1}`}>
  <div class="quien__texto">
    <h2 id={idTitulo} class="solo-lectores">{`${textos.pasada} ${numero} · ${plano.nombre[idioma]}`}</h2>
    {
      conSelector ? (
        <div class="quien__pasadas" role="radiogroup" aria-label={textos.capasAyuda}>
          {capas.map((capa, i) => (
            <>
              <input
                class={`solo-lectores es-${capa}`}
                type="radio"
                name={grupo}
                id={`${grupo}-${capa}`}
                checked={capa === pasada}
              />
              <label for={`${grupo}-${capa}`}>
                <span class="mono">0{i + 1}</span>
                {nombres[capa]}
              </label>
            </>
          ))}
        </div>
      ) : (
        <ol class="quien__pasadas" aria-hidden="true">
          {capas.map((capa, i) => (
            <li class:list={{ 'es-actual': capa === pasada }}>
              <span class="mono">0{i + 1}</span>
              {nombres[capa]}
            </li>
          ))}
        </ol>
      )
    }
    <p class="quien__frase">{frase}</p>
    {plano.nota && <p class="adhesiva a-mano">{plano.nota[idioma]}</p>}
  </div>

  <figure class="quien__figura flota">
    <span class="folio__clavijas" aria-hidden="true"><i></i><i></i><i></i></span>
    {
      visibles.map((capa) => (
        <Picture
          src={fuentes[capa]}
          formats={['avif', 'webp']}
          widths={[640, 960, 1344, 1672]}
          sizes="(max-width: 820px) 180vw, 110vw"
          alt={textos.altAvatar[capa]}
          loading={capa === pasada ? 'eager' : 'lazy'}
          pictureAttributes={{ class: `capa capa--${capa}` }}
        />
      ))
    }
  </figure>
</div>

<style>
  .quien {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(16px, 4vw, 64px);
    min-height: 0;
  }

  .quien__texto {
    display: grid;
    justify-items: start;
    gap: clamp(14px, 2.2vw, 26px);
    min-width: 0;
  }

  /* Las tres pasadas, con la de este plano encendida. En la final son un selector. */
  .quien__pasadas {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .quien__pasadas :is(li, label) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 4px 12px;
    border: 1.5px solid rgb(243 235 221 / 0.26);
    color: var(--texto-2);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .quien__pasadas .mono {
    font-weight: 400;
    color: var(--amarillo);
  }

  .quien__pasadas label {
    min-height: 44px;
    cursor: pointer;
  }

  .quien__pasadas label:hover {
    border-color: var(--amarillo);
    color: var(--texto);
  }

  .quien__pasadas :is(.es-actual, input:checked + label) {
    border-color: var(--amarillo);
    background: var(--amarillo);
    color: var(--grafito);
  }

  .quien__pasadas :is(.es-actual, input:checked + label) .mono {
    color: var(--grafito);
  }

  .quien__pasadas input:focus-visible + label {
    outline: 3px solid var(--pantalla);
    outline-offset: 3px;
  }

  .quien__frase {
    max-width: 24ch;
    font-size: clamp(1.4rem, 3.9vw, 3.4rem);
    font-weight: 650;
    line-height: 1.12;
    text-wrap: balance;
  }

  /* La hoja iluminada dentro de la sala. */
  .quien__figura {
    position: relative;
    height: min(72svh, 620px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid #bcc4bf;
    background: #f6f8f6;
    transform: rotate(1.4deg);
  }

  /* Acercamiento lento y continuo al avatar a lo largo de los tres planos. */
  .quien__figura :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 91% 50%;
    transform-origin: 60% 26%;
    scale: calc(1 + (var(--n) + var(--p, 0.5)) * 0.035);
  }

  /* El selector de capas: solo se ve la pasada elegida. */
  [data-pasada='final'] .quien__figura :global(.capa) {
    display: none;
  }

  [data-pasada='final']:has(.es-boceto:checked) .quien__figura :global(.capa--boceto),
  [data-pasada='final']:has(.es-tinta:checked) .quien__figura :global(.capa--tinta),
  [data-pasada='final']:has(.es-final:checked) .quien__figura :global(.capa--final) {
    display: inline;
  }

  /* En la pasada final la hoja desaparece y el personaje queda fuera del marco:
     la figura entera se funde con la sala y el fondo oscuro del dibujo desaparece. */
  [data-pasada='final']:has(.es-final:checked) .quien__figura {
    border-color: transparent;
    background: none;
    transform: scale(1.08);
    mix-blend-mode: lighten;
  }

  [data-pasada='final']:has(.es-final:checked) .folio__clavijas {
    display: none;
  }

  [data-pasada='final']:has(.es-final:checked) .quien__figura :global(img) {
    mask-image: linear-gradient(to right, transparent 0%, #000 22%);
  }

  /* Navegadores sin :has(): se queda la pasada final, sin selector que la cambie. */
  @supports not selector(:has(*)) {
    [data-pasada='final'] .quien__figura :global(.capa--final) {
      display: inline;
    }

    [data-pasada='final'] .quien__figura {
      border-color: transparent;
      background: none;
      transform: scale(1.08);
      mix-blend-mode: lighten;
    }

    [data-pasada='final'] .folio__clavijas,
    [data-pasada='final'] .quien__pasadas {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor .plano.es-activo) .quien__texto > * {
      animation: asentar-frase var(--f8) var(--asentar) both;
    }

    :global(.con-motor .plano.es-activo) .quien__texto > :nth-child(2) {
      animation-delay: var(--f2);
    }

    :global(.con-motor .plano.es-activo) .quien__texto > :nth-child(3) {
      animation-delay: var(--f8);
    }
  }

  @keyframes asentar-frase {
    from {
      opacity: 0;
      translate: 0 20px;
    }
  }

  @media (max-width: 820px) {
    .quien {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      justify-items: center;
    }

    .quien__figura {
      order: -1;
      height: min(38svh, 340px);
    }

    .quien__texto {
      justify-self: stretch;
    }

    .quien__frase {
      max-width: 28ch;
      font-size: clamp(1.15rem, 5vw, 1.6rem);
    }
  }
</style>
