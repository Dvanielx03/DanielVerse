---
// E1-P2 · La ruptura. La hoja se agrieta, la cámara se aleja y resulta ser una viñeta más de la
// pared de storyboard; la pared cae a oscuro y queda el lema.
// Todo depende de --p, el avance del plano: mismo scroll, mismo fotograma.
import { ESCENAS, type Arte, type Idioma, type Plano } from '../../datos/pelicula';

interface Props {
  plano: Plano;
  idioma: Idioma;
  idTitulo: string;
}

const { plano, idioma, idTitulo } = Astro.props;

// La hoja se parte en triángulos desde un punto de impacto hasta el borde.
type Punto = [number, number];
const impacto: Punto = [1050, 420];
const borde: Punto[] = [
  [0, 0],
  [520, 0],
  [1100, 0],
  [1600, 0],
  [1600, 380],
  [1600, 900],
  [1000, 900],
  [380, 900],
  [0, 900],
  [0, 430],
];

// Cada grieta se quiebra a mitad de camino para no parecer trazada con regla.
const grietas = borde.map((punto, i) => {
  const mx = (impacto[0] + punto[0]) / 2;
  const my = (impacto[1] + punto[1]) / 2;
  const largo = Math.hypot(punto[0] - impacto[0], punto[1] - impacto[1]);
  const desvio = (i % 2 === 0 ? 1 : -1) * 14;
  const qx = Math.round(mx - ((punto[1] - impacto[1]) / largo) * desvio);
  const qy = Math.round(my + ((punto[0] - impacto[0]) / largo) * desvio);
  return `M${impacto.join(' ')} L${qx} ${qy} L${punto.join(' ')}`;
});

const trozos = borde.map((a, i) => {
  const b = borde[(i + 1) % borde.length] as Punto;
  const cx = (impacto[0] + a[0] + b[0]) / 3;
  const cy = (impacto[1] + a[1] + b[1]) / 3;
  const largo = Math.hypot(cx - impacto[0], cy - impacto[1]);
  return {
    puntos: `${impacto.join(',')} ${a.join(',')} ${b.join(',')}`,
    cx: Math.round(cx),
    cy: Math.round(cy),
    dx: Math.round(((cx - impacto[0]) / largo) * 1500),
    dy: Math.round(((cy - impacto[1]) / largo) * 1500),
    giro: (i % 2 === 0 ? -1 : 1) * (16 + i * 5),
  };
});

// La pared: una hoja por plano de la película, cada una con su garabato de storyboard.
const garabatos = {
  claqueta:
    'M200 320 H1400 V720 H200 Z M200 320 L260 200 H1400 L1340 320 M470 200 L410 320 M700 200 L640 320 M930 200 L870 320 M1160 200 L1100 320',
  estallido:
    'M800 450 L300 150 M800 450 L1350 200 M800 450 L1250 760 M800 450 L420 780 M800 450 L800 110 M800 450 L1500 480 M800 450 L130 470',
  retrato:
    'M1040 330 a110 110 0 1 0 220 0 a110 110 0 1 0 -220 0 M940 760 C960 560 1340 560 1360 760 M200 300 H760 M200 400 H680 M200 500 H720',
  esquema: 'M880 250 H1400 V650 H880 Z M980 650 V720 M1300 650 V720 M200 300 H700 M200 400 H560 M200 500 H620',
  reja: 'M220 220 H580 V420 H220 Z M620 220 H980 V420 H620 Z M1020 220 H1380 V420 H1020 Z M220 480 H580 V680 H220 Z M620 480 H980 V680 H620 Z M1020 480 H1380 V680 H1020 Z',
  diptico: 'M180 240 H720 V660 H180 Z M880 240 H1420 V660 H880 Z M740 450 H860 M830 420 L860 450 L830 480',
  capas: 'M240 240 H1100 V340 H240 Z M340 390 H1200 V490 H340 Z M440 540 H1300 V640 H440 Z',
  tiempo: 'M180 330 H1420 V430 H180 Z M180 480 H1420 V580 H180 Z M520 330 V430 M900 330 V430 M1040 260 V650',
  creditos: 'M560 220 H1040 M620 330 H980 M660 420 H940 M620 510 H980 M660 600 H940 M580 690 H1020',
};
const garabatoDe: Record<Arte, keyof typeof garabatos> = {
  claqueta: 'claqueta',
  convencional: 'reja',
  ruptura: 'estallido',
  'avatar-boceto': 'retrato',
  'avatar-tinta': 'retrato',
  'avatar-final': 'retrato',
  reto: 'esquema',
  pared: 'reja',
  proyecto: 'claqueta',
  diptico: 'diptico',
  inspeccion: 'capas',
  truco: 'tiempo',
  herramientas: 'diptico',
  pixel: 'esquema',
  creditos: 'creditos',
  contacto: 'retrato',
};
const planos = ESCENAS.flatMap((escena) => escena.planos);
// La hoja que se rompe es la del plano anterior: el portafolio de siempre.
const propia = planos.findIndex((p) => p.id === plano.id) - 1;
const hojas = planos.map((p, i) => ({
  id: p.id,
  indice: i,
  garabato: garabatos[garabatoDe[p.arte ?? 'pared']],
  retraso: (((i * 7) % 11) / 11) * 0.4,
  giro: (i % 2 === 0 ? -1 : 1) * (5 + ((i * 5) % 13)),
}));
---

<div class="rup">
  <h2 id={idTitulo} class="lema">{plano.titular?.[idioma]}</h2>

  <svg class="papel" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      {
        trozos.map((trozo, i) => (
          <clipPath id={`rup-recorte-${i}`}>
            <polygon points={trozo.puntos} />
          </clipPath>
        ))
      }
      <g id="rup-hoja">
        <rect width="1600" height="900" fill="#f6f8f6"></rect>
        <g fill="none" stroke="#3f7fd9" stroke-width="4" stroke-linecap="round">
          <rect x="250" y="130" width="1100" height="640" rx="16"></rect>
          <line x1="250" y1="196" x2="1350" y2="196"></line>
          <circle cx="292" cy="163" r="9"></circle>
          <circle cx="324" cy="163" r="9"></circle>
          <circle cx="356" cy="163" r="9"></circle>
          <circle cx="470" cy="385" r="100"></circle>
          <rect x="630" y="398" width="340" height="18" rx="6"></rect>
          <rect x="630" y="436" width="96" height="30" rx="12"></rect>
          <rect x="738" y="436" width="126" height="30" rx="12"></rect>
          <rect x="876" y="436" width="96" height="30" rx="12"></rect>
          <rect x="300" y="580" width="310" height="140" rx="10"></rect>
          <path d="M300 580 L610 720 M610 580 L300 720"></path>
          <rect x="645" y="580" width="310" height="140" rx="10"></rect>
          <path d="M645 580 L955 720 M955 580 L645 720"></path>
          <rect x="990" y="580" width="310" height="140" rx="10"></rect>
          <path d="M990 580 L1300 720 M1300 580 L990 720"></path>
        </g>
        <rect x="630" y="318" width="470" height="56" rx="6" fill="#1f2327"></rect>
      </g>
    </defs>

    <g class="camara">
      {
        hojas
          .filter((hoja) => hoja.indice !== propia)
          .map((hoja) => (
            <g class="hoja" style={`--i:${hoja.indice};--retraso:${hoja.retraso.toFixed(2)};--giro:${hoja.giro}deg`}>
              <rect width="1600" height="900" rx="12" />
              <path d={hoja.garabato} />
              <text x="96" y="168">{hoja.id}</text>
            </g>
          ))
      }
      <g class="propia" style={`--i:${propia}`}>
        <rect class="base" width="1600" height="900" fill="#f6f8f6"></rect>
        {
          trozos.map((trozo, i) => (
            <g
              class="trozo"
              clip-path={`url(#rup-recorte-${i})`}
              style={`--dx:${trozo.dx}px;--dy:${trozo.dy}px;--giro:${trozo.giro}deg;transform-origin:${trozo.cx}px ${trozo.cy}px`}
            >
              <use href="#rup-hoja" />
            </g>
          ))
        }
        <g class="grietas">
          {grietas.map((d) => <path pathLength="1" d={d} />)}
        </g>
        <ellipse class="cerco" cx="800" cy="450" rx="640" ry="350" pathLength="1" transform="rotate(-4 800 450)"
        ></ellipse>
      </g>
    </g>
  </svg>
</div>

<style>
  /* Sin motor o con movimiento reducido: el lema ya terminado y sin hoja encima. */
  .rup {
    --cerco: 1;
    --grieta: 1;
    --avance: 1;
    --luz: 1;
    display: grid;
    align-items: center;
    min-height: 0;
  }

  .papel {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor) .rup {
      /* Cuatro tiempos: el cerco rojo, las grietas, el alejamiento a la pared y la caída. */
      --cerco: clamp(0, calc(var(--p, 0) / 0.16), 1);
      --grieta: clamp(0, calc((var(--p, 0) - 0.14) / 0.16), 1);
      /* La cámara se aleja a saltos de un fotograma, como animación dibujada. */
      --lejos: round(nearest, clamp(0, calc((var(--p, 0) - 0.3) / 0.26), 1), 0.0833);
      --vuelo: clamp(0, calc((var(--p, 0) - 0.56) / 0.3), 1);
      --paso: round(nearest, var(--vuelo), 0.05);
      /* La caída acelera. */
      --avance: calc(var(--paso) * var(--paso));
      --luz: clamp(0, calc(var(--paso) * 2.5), 1);
    }

    :global(.con-motor) .papel {
      display: block;
    }
  }

  /* La pared se reparte según la forma de la pantalla. --sf es la escala a la que cabe entera;
     --tfx y --tfy la centran en la parte visible del encuadre. */
  .papel {
    --cols: 7;
    --sf: 0.108;
    --tfx: 143px;
    --tfy: 239px;
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media (max-aspect-ratio: 3/2) {
    .papel {
      --cols: 5;
      --sf: 0.1;
      --tfx: 368px;
      --tfy: 205px;
    }
  }

  @media (max-aspect-ratio: 1/1) {
    .papel {
      --cols: 3;
      --sf: 0.1;
      --tfx: 544px;
      --tfy: 5px;
    }
  }

  @media (max-aspect-ratio: 3/5) {
    .papel {
      --cols: 2;
      --sf: 0.115;
      --tfx: 607px;
      --tfy: 30px;
    }
  }

  /* Cámara: empieza llenando el encuadre con la hoja propia y se aleja hasta la pared entera;
     al caer la pared vuelve a avanzar, hacia el oscuro. */
  .camara {
    --s: calc(pow(var(--sf), var(--lejos, 0)) * (1.1 - 0.1 * var(--cerco)) * (1 + 1.2 * var(--avance)));
    --u: calc((var(--s) - var(--sf)) / (1 - var(--sf)));
    transform: translate(
        calc(var(--tfx) + (-1760px - var(--tfx)) * var(--u)),
        calc(var(--tfy) - var(--tfy) * var(--u))
      )
      scale(var(--s));
  }

  /* Cada hoja ocupa su hueco de la pared: columna y fila salen de su número de plano. */
  .hoja,
  .propia {
    --col: mod(var(--i), var(--cols));
    --fila: round(down, calc(var(--i) / var(--cols)), 1);
  }

  .propia {
    transform: translate(calc(var(--col) * 1760px), calc(var(--fila) * 1000px));
  }

  /* Las demás hojas se sueltan una tras otra y caen girando. */
  .hoja {
    --c: clamp(0, calc((var(--paso, 0) - var(--retraso)) / 0.6), 1);
    transform: translate(
        calc(var(--col) * 1760px),
        calc(var(--fila) * 1000px + var(--c) * var(--c) * 1300px / var(--sf))
      )
      translate(800px, 450px) rotate(calc(var(--giro) * var(--c))) translate(-800px, -450px);
  }

  .hoja rect {
    fill: #dfe5e1;
  }

  .hoja path {
    fill: none;
    stroke: #3f7fd9;
    stroke-width: 1.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .hoja text {
    fill: #2456a6;
    font-family: var(--fuente);
    font-size: 104px;
    font-variation-settings: 'MONO' 1;
    letter-spacing: 0.06em;
  }

  /* Tapa las juntas entre trozos hasta que empiezan a volar. */
  .base {
    opacity: calc(1 - var(--avance) * 1000);
  }

  .trozo {
    transform: translate(calc(var(--dx) * var(--avance) / var(--sf)), calc(var(--dy) * var(--avance) / var(--sf)))
      rotate(calc(var(--giro) * var(--avance)));
  }

  .grietas path {
    fill: none;
    stroke: #1f2327;
    /* El grosor se compensa con la escala de la cámara para que no adelgace al alejarse. */
    stroke-width: calc(2.5px / var(--s));
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--grieta));
    opacity: calc(1 - var(--avance) * 30);
  }

  /* El cerco rojo sigue marcando la hoja en la pared hasta que estalla. */
  .cerco {
    fill: none;
    stroke: #d8334a;
    stroke-width: calc(5px / var(--s));
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--cerco));
    opacity: calc(1 - var(--avance) * 30);
  }

  /* El lema nace en el oscuro: pasa de letra de boceto a letra exacta y gana su fuera de registro. */
  .lema {
    max-width: 13ch;
    font-size: clamp(2.75rem, 11.5vw, 10rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-wrap: balance;
    font-variation-settings:
      'MONO' 0,
      'CASL' calc(1 - var(--avance)),
      'slnt' calc(-8 * (1 - var(--avance))),
      'CRSV' 0.5;
    text-shadow:
      calc(-0.04em * var(--avance)) 0 var(--rojo-luz),
      calc(0.04em * var(--avance)) 0 var(--azul-luz);
    opacity: var(--luz);
    transform: scale(calc(0.88 + 0.12 * var(--avance)));
    transform-origin: left center;
  }
</style>
