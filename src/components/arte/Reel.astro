---
// E5 · «Siete mundos»: el showreel. El video corre mientras la sección está en pantalla y, al lado,
// se enciende el mundo que está sonando. Sin JavaScript o con movimiento reducido, es un video con controles.
import { getImage } from 'astro:assets';

import poster from '../../assets/reel/poster.jpg';
import reel from '../../assets/reel/siete-mundos.mp4?url';
import { INTERFAZ } from '../../datos/interfaz';
import type { Idioma, Plano } from '../../datos/pelicula';

interface Props {
  plano: Plano;
  idioma: Idioma;
  idTitulo: string;
}

const { plano, idioma, idTitulo } = Astro.props;
const textos = INTERFAZ[idioma];
const cartel = await getImage({ src: poster, width: 720, format: 'webp' });
const [subtitulo, lema] = plano.lineas?.[idioma] ?? [];
const capitulos = plano.capitulos ?? [];
---

<div class="reel" data-reel>
  <div class="reel__texto">
    <p class="reel__rotulo mono">Showreel 2026</p>
    <h2 id={idTitulo} class="reel__titular">{plano.titular?.[idioma]}</h2>
    {subtitulo && <p class="reel__sub">{subtitulo}</p>}
    <ol class="reel__mundos">
      {
        capitulos.map((capitulo, i) => (
          <li data-desde={capitulo.desde} data-hasta={capitulos[i + 1]?.desde ?? plano.finCapitulos ?? 999}>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            {capitulo.nombre[idioma]}
          </li>
        ))
      }
    </ol>
    {lema && <p class="reel__lema a-mano">{lema}</p>}
  </div>

  <figure class="reel__pantalla">
    <video
      src={reel}
      poster={cartel.src}
      width="720"
      height="900"
      muted
      playsinline
      loop
      controls
      preload="none"
      aria-label={textos.reelAlt}
    >
    </video>
    <span class="reel__barra" aria-hidden="true"><i></i></span>
    <button class="reel__pausa" type="button" aria-pressed="false" hidden>
      <span class="reel__icono" aria-hidden="true"></span>
      <span class="solo-lectores">{textos.reelPausa}</span>
    </button>
  </figure>
</div>

<script>
  // Cada reel se reproduce mientras su sección está activa y se detiene al salir.
  // Solo el motor de la página marca una sección como activa: sin él, el video conserva sus controles.
  const movimientoReducido = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const caja of document.querySelectorAll<HTMLElement>('[data-reel]')) {
    const video = caja.querySelector('video');
    const seccion = caja.closest<HTMLElement>('.plano');
    const boton = caja.querySelector<HTMLButtonElement>('.reel__pausa');
    const mundos = [...caja.querySelectorAll<HTMLElement>('.reel__mundos li')];
    if (!video || !seccion || !boton) continue;

    let preparado = false;
    let pausadoAMano = false;

    const reproducir = () => {
      if (pausadoAMano) return;
      video.preload = 'auto';
      void video.play().catch(() => {
        // El navegador puede negarse a reproducir; el cartel sigue a la vista.
      });
    };

    const alCambiar = () => {
      const activa = seccion.classList.contains('es-activo');
      // Con movimiento reducido nada arranca solo: el video se queda con sus controles.
      if (!activa || movimientoReducido.matches) {
        video.pause();
        pausadoAMano = false;
        return;
      }
      if (!preparado) {
        preparado = true;
        video.controls = false;
        boton.hidden = false;
      }
      reproducir();
    };
    new MutationObserver(alCambiar).observe(seccion, { attributes: true, attributeFilter: ['class'] });
    alCambiar();

    boton.addEventListener('click', () => {
      if (video.paused) {
        pausadoAMano = false;
        reproducir();
      } else {
        pausadoAMano = true;
        video.pause();
      }
    });
    video.addEventListener('play', () => boton.setAttribute('aria-pressed', 'false'));
    video.addEventListener('pause', () => boton.setAttribute('aria-pressed', 'true'));

    // La barra y el mundo encendido siguen al video.
    const pintar = () => {
      const t = video.currentTime;
      caja.style.setProperty('--avance-reel', video.duration ? String(t / video.duration) : '0');
      for (const mundo of mundos) {
        const dentro = t >= Number(mundo.dataset.desde) && t < Number(mundo.dataset.hasta);
        mundo.classList.toggle('suena', dentro);
      }
      if (!video.paused) requestAnimationFrame(pintar);
    };
    video.addEventListener('play', () => requestAnimationFrame(pintar));
    video.addEventListener('seeked', pintar);
  }
</script>

<style>
  .reel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(20px, 4vw, 72px);
    min-height: 0;
  }

  .reel__texto {
    display: grid;
    justify-items: start;
    gap: clamp(10px, 1.8vw, 18px);
    min-width: 0;
  }

  .reel__rotulo {
    padding: 3px 10px;
    background: #05030c;
    color: var(--cian);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .reel__titular {
    font-size: clamp(2.6rem, 8vw, 7rem);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-shadow:
      calc(var(--registro) * -1) 0 var(--rojo-luz),
      var(--registro) 0 var(--azul-luz);
  }

  .reel__sub {
    font-size: clamp(1.05rem, 2vw, 1.45rem);
    font-weight: 600;
    color: var(--texto-2);
  }

  /* Los siete mundos: el que está sonando se enciende como un cartucho. */
  .reel__mundos {
    display: grid;
    gap: 4px;
    margin-top: clamp(4px, 1vw, 10px);
  }

  .reel__mundos li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 3px 10px;
    border: 2px solid transparent;
    color: var(--texto-2);
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    font-weight: 700;
    transition:
      background var(--f2) linear,
      color var(--f2) linear,
      translate var(--f2) var(--golpe);
  }

  .reel__mundos .mono {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--amarillo);
  }

  .reel__mundos li.suena {
    border-color: #05030c;
    background: var(--amarillo);
    color: #05030c;
    box-shadow: 4px 4px 0 var(--magenta);
    translate: 6px 0;
  }

  .reel__mundos li.suena .mono {
    color: #05030c;
  }

  .reel__lema {
    margin-top: clamp(4px, 1vw, 10px);
    color: var(--magenta);
    font-size: clamp(1.05rem, 2vw, 1.5rem);
    rotate: -2deg;
  }

  /* La pantalla: una viñeta vertical con borde de tinta y su sombra en dos colores. */
  .reel__pantalla {
    position: relative;
    height: min(74svh, 760px);
    aspect-ratio: 4 / 5;
    margin: 0;
    border: 4px solid #05030c;
    background: #05030c;
    box-shadow:
      12px 12px 0 var(--magenta),
      20px 20px 0 var(--cian);
    rotate: 1.5deg;
  }

  .reel__pantalla video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #05030c;
  }

  .reel__barra {
    position: absolute;
    inset: auto 0 0;
    height: 5px;
    background: rgb(246 239 228 / 0.18);
  }

  .reel__barra i {
    display: block;
    width: calc(var(--avance-reel, 0) * 100%);
    height: 100%;
    background: var(--amarillo);
  }

  .reel__pausa[hidden] {
    display: none;
  }

  .reel__pausa {
    position: absolute;
    right: 12px;
    bottom: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 2.5px solid #05030c;
    background: var(--amarillo);
    box-shadow: 3px 3px 0 #05030c;
    cursor: pointer;
  }

  /* Dos barras mientras corre; un triángulo cuando está en pausa. */
  .reel__icono {
    width: 14px;
    height: 16px;
    background: linear-gradient(90deg, #05030c 0 35%, transparent 35% 65%, #05030c 65%);
  }

  .reel__pausa[aria-pressed='true'] .reel__icono {
    background: #05030c;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .reel__pausa:focus-visible {
    outline: 3px solid var(--pantalla);
    outline-offset: 3px;
  }

  @media (max-width: 820px) {
    .reel {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      justify-items: center;
    }

    .reel__pantalla {
      order: -1;
      height: min(46svh, 420px);
      box-shadow:
        7px 7px 0 var(--magenta),
        12px 12px 0 var(--cian);
    }

    .reel__texto {
      justify-self: stretch;
    }

    .reel__titular {
      font-size: clamp(2rem, 9vw, 3rem);
    }

    /* En el móvil solo se lista el mundo que suena, para no tapar el video. */
    .reel__mundos li:not(.suena) {
      display: none;
    }

    .reel__sub,
    .reel__lema {
      display: none;
    }
  }
</style>
