---
// La hoja de contacto: todos los planos a la vista. Índice, vía rápida y versión sin movimiento.
import { INTERFAZ } from '../datos/interfaz';
import { ESCENAS, REPOSITORIOS, type Idioma } from '../datos/pelicula';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = INTERFAZ[idioma];
---

<section id="hoja" class="hoja" data-mundo="papel" aria-labelledby="hoja-titulo">
  <h2 id="hoja-titulo" class="hoja__titulo">{textos.hojaTitulo}</h2>
  <p class="hoja__intro">{textos.hojaIntro}</p>

  <section class="hoja__repos" aria-labelledby="hoja-repos">
    <h3 id="hoja-repos">{textos.repositorios}</h3>
    <ul>
      {
        REPOSITORIOS.map((repo) => (
          <li>
            <a href={repo.url}>
              <strong>{repo.nombre}</strong>
              <span>{repo.que[idioma]}</span>
              <span class="mono" aria-hidden="true">
                GitHub ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <ol class="hoja__escenas">
    {
      ESCENAS.map((escena, numero) => (
        <li class="hoja__escena">
          <h3>
            <span class="mono">{numero}</span> {escena.nombre[idioma]}
          </h3>
          <ol class="hoja__planos">
            {escena.planos.map((plano) => (
              <li>
                <a href={`#${plano.id}`} data-ir={plano.id} data-mundo={plano.mundo}>
                  <span class="mono">{plano.id}</span>
                  <span>{plano.titular?.[idioma] ?? plano.nombre[idioma]}</span>
                </a>
              </li>
            ))}
          </ol>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .hoja {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 24px;
    min-height: 100svh;
    padding: 72px max(16px, 5vw) 128px;
    background: var(--fondo);
    color: var(--texto);
  }

  /* Deja una pantalla libre para que el último plano se vea entero antes de que suba la hoja. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.con-motor) .hoja {
      margin-top: 100svh;
    }
  }

  .hoja__titulo {
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 900;
    line-height: 1;
  }

  .hoja__intro {
    max-width: 60ch;
    color: var(--texto-2);
  }

  .hoja__escenas {
    display: grid;
    gap: 28px;
  }

  /* Los repositorios: tarjetas en negro con su acceso directo a GitHub. */
  .hoja__repos {
    display: grid;
    gap: 10px;
  }

  .hoja__repos h3 {
    font-size: 1rem;
    font-weight: 800;
  }

  .hoja__repos ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
    gap: 12px;
  }

  .hoja__repos a {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border: 2.5px solid #05030c;
    background: #05030c;
    color: var(--pantalla);
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--magenta);
    transition:
      translate var(--f2) var(--golpe),
      box-shadow var(--f2) var(--golpe);
  }

  .hoja__repos a span:not(.mono) {
    color: var(--gris-sala);
    font-size: 0.875rem;
  }

  .hoja__repos a .mono {
    justify-self: start;
    margin-top: 6px;
    padding: 1px 6px;
    background: var(--amarillo);
    color: #05030c;
    font-size: 0.6875rem;
  }

  .hoja__repos a:hover {
    translate: -2px -2px;
    box-shadow: 7px 7px 0 var(--cian);
  }

  .hoja__escena {
    display: grid;
    gap: 10px;
  }

  .hoja__escena h3 {
    font-size: 1rem;
    font-weight: 800;
  }

  .hoja__planos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    gap: 12px;
  }

  .hoja__planos a {
    display: grid;
    align-content: space-between;
    gap: 12px;
    aspect-ratio: 16 / 9;
    padding: 10px 12px;
    border: 1.5px solid var(--grafito);
    background: var(--fondo);
    color: var(--texto);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }

  .hoja__planos a .mono {
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--texto-2);
  }

  .hoja__planos a:hover {
    outline: 3px solid var(--amarillo);
    outline-offset: 2px;
  }
</style>
